# Local only. Never point this at production. Use `pnpm db:pull` to copy prod data.
DATABASE_URL=postgresql://family_tree@127.0.0.1:5432/family_tree
SESSION_SECRET=replace-with-32-plus-random-characters
APP_URL=http://localhost:3000
# Optional in development: without a key, emails are printed to the server console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=family-tree <hello@example.com>
# Birthday emails run automatically in production after this UTC hour.
# In development, set BIRTHDAY_EMAILS=on to test them (printed to the console).
BIRTHDAY_EMAILS=
BIRTHDAY_EMAIL_HOUR_UTC=8
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=family-tree
S3_ACCESS_KEY_ID=S3RVER
S3_SECRET_ACCESS_KEY=S3RVER
S3_FORCE_PATH_STYLE=true
# Backups go to a second bucket. Locally this points at s3rver; in production
# use a second Railway Storage Bucket in the same project and region.
BACKUP_S3_ENDPOINT=http://127.0.0.1:9000
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=family-tree-backups
BACKUP_S3_ACCESS_KEY_ID=S3RVER
BACKUP_S3_SECRET_ACCESS_KEY=S3RVER
BACKUP_S3_FORCE_PATH_STYLE=true
# Set to off to back up PostgreSQL only.
BACKUP_MEDIA=
# Log verbosity: debug, info, warn, error. Defaults to info in production.
LOG_LEVEL=
# Sentry is optional. The client DSN is public; the server DSN is a secret.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_RELEASE=
# Only needed to upload source maps during the build.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Optional Umami analytics. Set both values to inject the tracking script;
# leave them blank to disable analytics entirely.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
# Shown in quota errors and the usage card, and used as the support address.
SUPPORT_EMAIL=samuele+family-tree@zanca.dev
# Optional. Receives the daily abuse digest when set.
ADMIN_ALERT_EMAIL=
