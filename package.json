{
  "name": "family-tree",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "tsx scripts/assert-local-db.ts && vite dev --host 0.0.0.0",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:services": "bash scripts/dev-services.sh start",
    "dev:stop": "bash scripts/dev-services.sh stop",
    "dev:status": "bash scripts/dev-services.sh status",
    "dev:reset-db": "bash scripts/dev-services.sh reset",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/assert-local-db.ts --allow-deployed && tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/assert-local-db.ts && tsx scripts/seed.ts",
    "db:pull": "tsx scripts/db-pull.ts",
    "db:check": "tsx scripts/db-check.ts",
    "icons:generate": "tsx scripts/generate-simple-icons.ts",
    "usage:report": "tsx scripts/usage-report.ts",
    "abuse:report": "tsx scripts/abuse-report.ts",
    "maintenance:run": "tsx scripts/maintenance.ts",
    "tree:purge": "tsx scripts/purge-tree.ts",
    "storage:cors": "tsx scripts/storage-cors.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:verify": "tsx scripts/backup-verify.ts",
    "backup:restore": "tsx scripts/backup-restore.ts",
    "openapi:check": "redocly lint openapi/roots-v1.json && tsx scripts/openapi-check.ts"
  },
  "devDependencies": {
    "@redocly/cli": "^2.79.0",
    "@sentry/vite-plugin": "^11.12.0",
    "@types/archiver": "^8.0.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.23.1",
    "@types/s3rver": "^3.7.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.10",
    "s3rver": "^3.7.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-presigned-post": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@kobalte/core": "^0.13.14",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@sentry/browser": "^11.12.0",
    "@sentry/node": "^11.12.0",
    "@solid-primitives/resize-observer": "^2.2.0",
    "@solid-primitives/websocket": "^1.4.0",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "archiver": "^8.0.0",
    "cva": "1.0.0-beta.4",
    "d3-force": "^3.0.0",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "file-type": "^22.3.0",
    "force-graph": "^1.52.0",
    "lucide-solid": "^1.73.0",
    "nitro": "3.0.260903-beta",
    "pg": "^8.23.1",
    "resend": "^6.38.1",
    "solid-js": "^1.9.14",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.1.4",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
